{
  "resources": [
    {
      "name": "Department",
      "pluginName": "hr",
      "package": "gasi.one.plugins.hr.department",
      "table": "hr_departments",
      "endpoint": "/departments",
      "lookup": true,
      "fields": [
        {
          "name": "code",
          "type": "string",
          "projection": true,
          "column": "department_code",
          "length": 50,
          "required": true,
          "unique": true,
          "validation": {
            "minLength": 2,
            "maxLength": 50,
            "pattern": "^[A-Z0-9-]+$"
          }
        },
        {
          "name": "name",
          "type": "string",
          "projection": true,
          "length": 150,
          "required": true
        }
      ],
      "i18n": {
        "id": {
          "field": {
            "code": "Kode",
            "name": "Nama"
          },
          "validation": {
            "code": {
              "pattern": "Kode hanya boleh berisi huruf besar, angka, dan tanda hubung"
            }
          }
        }
      }
    },
    {
      "name": "Employee",
      "pluginName": "hr",
      "package": "gasi.one.plugins.hr.employee",
      "mode": "crud",
      "fields": [
        {
          "name": "employeeNo",
          "type": "string",
          "projection": true,
          "length": 50,
          "required": true,
          "unique": true
        },
        {
          "name": "fullName",
          "type": "string",
          "projection": true,
          "length": 150,
          "required": true
        },
        {
          "name": "employmentType",
          "type": "enum",
          "enum": {
            "name": "EmploymentType",
            "values": ["PERMANENT", "CONTRACT"]
          }
        },
        {
          "name": "salary",
          "type": "decimal",
          "precision": 19,
          "scale": 2,
          "dto": {
            "summary": false
          },
          "validation": {
            "positiveOrZero": true
          }
        },
        {
          "name": "active",
          "type": "boolean",
          "defaultValue": true
        },
        {
          "name": "department",
          "type": "long",
          "required": true,
          "relation": {
            "type": "many-to-one",
            "target": "Department",
            "package": "gasi.one.plugins.hr.department",
            "labelField": "name",
            "joinColumn": "department_id",
            "fetch": "lazy"
          }
        }
      ]
    },
    {
      "name": "EmployeeAsset",
      "mode": "embed",
      "pluginName": "hr",
      "package": "gasi.one.plugins.hr.employeeasset",
      "parent": {
        "resource": "Employee",
        "field": "assets"
      },
      "fields": [
        {
          "name": "employee",
          "type": "long",
          "required": true,
          "relation": {
            "type": "many-to-one",
            "target": "Employee",
            "package": "gasi.one.plugins.hr.employee",
            "joinColumn": "employee_id",
            "fetch": "lazy"
          }
        },
        {
          "name": "assetNo",
          "type": "string",
          "length": 80,
          "required": true
        },
        {
          "name": "description",
          "type": "string",
          "length": 150
        }
      ]
    },
    {
      "name": "EmployeeCertification",
      "pluginName": "hr",
      "package": "gasi.one.plugins.hr.employeecertification",
      "endpoint": "/certifications",
      "parent": {
        "resource": "Employee",
        "route": "nested"
      },
      "fields": [
        {
          "name": "employee",
          "type": "long",
          "required": true,
          "relation": {
            "type": "many-to-one",
            "target": "Employee",
            "package": "gasi.one.plugins.hr.employee",
            "joinColumn": "employee_id",
            "fetch": "lazy"
          }
        },
        {
          "name": "certificationName",
          "type": "string",
          "projection": true,
          "length": 150,
          "required": true
        },
        {
          "name": "issuedAt",
          "type": "date"
        }
      ]
    }
  ]
}
